// Safaai Sarathi — PostgreSQL schema (plan §8)
//
// PostGIS is not installed on this machine and enabling it needs admin rights,
// so geometry is stored as plain lat/lng doubles plus a pre-computed bounding
// box on wards. All distance / nearest-truck / point-in-ward maths runs in
// src/lib/geo.js. The column layout is deliberately PostGIS-shaped: when the
// extension is available, `latitude`/`longitude` become
// `geography(Point,4326)` and the bbox filters become GiST index lookups
// without any change to the application's query surface.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums ----

enum Role {
  CITIZEN
  DRIVER
  OFFICER
  ADMIN
}

enum AssignmentType {
  MANUAL
  AUTO
}

enum ComplaintStatus {
  PENDING
  VERIFIED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WasteCategory {
  GARBAGE_PILE
  OVERFLOWING_BIN
  DEAD_ANIMAL
  CONSTRUCTION_DEBRIS
  MEDICAL_WASTE
  ILLEGAL_DUMPING
  SEWAGE_OVERFLOW
  BURNING_WASTE
  OTHER
}

/// How the waste is *processed*, as distinct from `WasteCategory`, which is
/// what the citizen reported seeing.
///
/// The two are deliberately separate axes. A garbage pile and an overflowing
/// bin are different incidents but the same processing stream; medical waste
/// and burning waste look nothing alike and both have to go to a licensed
/// hazardous handler. Routing a ticket to a company depends on this axis, and
/// collapsing it into the incident type would mean a company had to enumerate
/// every incident shape it accepts rather than the one thing it is licensed for.
enum WasteStream {
  /// Organic / wet — kitchen waste, garden waste, animal remains.
  BIO
  /// Dry and recyclable — paper, plastic, glass, metal, inert rubble.
  NON_BIO
  /// Requires a licensed handler — clinical, chemical, combustion, sewage.
  HAZARDOUS
  /// Electronic waste, handled under separate e-waste rules.
  E_WASTE
  /// Genuinely mixed or undetermined; needs an officer to look.
  OTHER
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

/// Lifecycle of one complaint handed to one processing company.
enum AssignmentStatus {
  PENDING_PICKUP
  PICKED
  COMPLETED
  CANCELLED
}

enum VehicleStatus {
  IDLE
  ON_ROUTE
  OFFLINE
  MAINTENANCE
}

enum RouteStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
}

enum StopStatus {
  PENDING
  DONE
  SKIPPED
}

enum NotificationType {
  COMPLAINT_UPDATE
  ASSIGNMENT
  EMERGENCY
  ESCALATION
  TRUCK_NEARBY
  CREDIT_AWARDED
  SYSTEM
}

enum ShiftStatus {
  ACTIVE
  /// Clocked in but stood down — a rest or meal break, truck stationary.
  ON_BREAK
  ENDED
}

enum SosStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum ReportChannel {
  APP
  WEB
  WHATSAPP
  IVR
}

// ------------------------------------------------------- identity & auth ----

model User {
  id              String    @id @default(cuid())
  name            String
  email           String?   @unique
  phone           String?   @unique
  passwordHash    String? // null when the account is Google-only
  role            Role      @default(CITIZEN)
  wardId          String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  language        String    @default("en") // en | hi | gu
  avatarColor     String    @default("#16a34a")
  avatarUrl       String? // uploaded profile photo; falls back to the initials/avatarColor circle when unset

  // Officer / Admin 2FA (plan §6.3) — TOTP via otplib, no auth SaaS.
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  greenCredits Int       @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ward                     Ward?                    @relation(fields: [wardId], references: [id], onDelete: SetNull)
  officerWards             WardOfficer[]
  oauthIdentities          OAuthIdentity[]
  refreshTokens            RefreshToken[]
  emailTokens              EmailToken[]
  complaints               Complaint[]              @relation("ComplaintCitizen")
  assignedComplaints       Complaint[]              @relation("ComplaintAssigner")
  resolvedComplaints       Complaint[]              @relation("ComplaintResolver")
  complaintEvents          ComplaintEvent[]
  drivenVehicles           Vehicle[]                @relation("VehicleDriver")
  routes                   Route[]
  escalationsReceived      Escalation[]             @relation("EscalationTarget")
  auditLogs                AuditLog[]
  notifications            Notification[]
  creditEntries            GreenCredit[]
  sosAlerts                SosAlert[]               @relation("SosDriver")
  sosAcknowledged          SosAlert[]               @relation("SosResponder")
  fuelLogs                 FuelLog[]
  shifts                   DriverShift[]
  scheduledPickups         ScheduledPickupRequest[] @relation("CitizenScheduledPickups")
  assignedScheduledPickups ScheduledPickupRequest[] @relation("DriverScheduledPickups")
  feedbacks                Feedback[]
  companyAssignments       ComplaintAssignment[]    @relation("CompanyAssignmentOfficer")

  @@index([role])
  @@index([wardId])
  @@map("users")
}

/// Google sign-in linkage — raw OAuth2/OIDC, no Firebase (plan §6.2).
model OAuthIdentity {
  id             String   @id @default(cuid())
  userId         String
  provider       String // "google"
  providerUserId String
  email          String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_identities")
}

/// Rotated on every use and revocable server-side, so a session can be killed.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Email verification + password reset tokens (stored hashed, with expiry).
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  purpose   String // "verify" | "reset"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_tokens")
}

/// Phone/OTP login for drivers (pre-registered by admin, no self-signup).
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  purpose    String    @default("driver_login")
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, purpose])
  @@map("otp_codes")
}

// ------------------------------------------------------------- geography ----

model Ward {
  id   String @id @default(cuid())
  name String
  code String @unique
  zone String @default("Zone 1")

  /// GeoJSON Polygon. Becomes geometry(Polygon,4326) under PostGIS.
  boundary  Json
  centerLat Float
  centerLng Float

  /// Pre-computed bbox so "which ward is this point in" is an indexed
  /// pre-filter followed by an exact ray-cast in geo.js.
  minLat Float
  maxLat Float
  minLng Float
  maxLng Float

  population Int      @default(0)
  households Int      @default(0)
  slaMinutes Int      @default(1440)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  residents          User[]
  officers           WardOfficer[]
  complaints         Complaint[]
  detectedComplaints Complaint[]              @relation("ComplaintDetectedWard")
  vehicles           Vehicle[]
  routes             Route[]
  predictions        HotspotPrediction[]
  contacts           EmergencyContact[]
  shifts             DriverShift[]
  scheduledPickups   ScheduledPickupRequest[]
  companies          CompanyWard[]

  @@index([minLat, maxLat, minLng, maxLng])
  @@map("wards")
}

/// An officer can be scoped to more than one ward (plan §2.3).
model WardOfficer {
  id        String   @id @default(cuid())
  wardId    String
  officerId String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  ward    Ward @relation(fields: [wardId], references: [id], onDelete: Cascade)
  officer User @relation(fields: [officerId], references: [id], onDelete: Cascade)

  @@unique([wardId, officerId])
  @@map("ward_officers")
}

// ------------------------------------------------------------- complaints ----

model Complaint {
  id        String  @id @default(cuid())
  code      String  @unique // human-readable ticket, e.g. SS-7F3K2Q
  citizenId String
  wardId    String?

  category     WasteCategory
  aiCategory   WasteCategory?
  aiConfidence Float          @default(0)
  aiVerified   Boolean        @default(false)
  reviewNeeded Boolean        @default(false) // confidence < threshold -> human review
  fraudScore   Float          @default(0)
  fraudSignals Json?

  /// Which processing stream this belongs to — see `WasteStream`.
  ///
  /// Nullable rather than defaulted: every complaint filed before this existed
  /// has no stream, and defaulting them all to OTHER would be indistinguishable
  /// from the classifier having actually looked and found it ambiguous. Null
  /// means "never classified", which the officer views can then ask about.
  wasteStream           WasteStream?
  /// 0-1, on the same scale as `aiConfidence`, and subject to the same
  /// <0.70 -> officer review rule. Derived from the vision classification, so
  /// it can never exceed the confidence of the class it was derived from.
  wasteStreamConfidence Float        @default(0)
  /// Set when an officer overrides the suggested stream, so the analytics can
  /// separate what the model got right from what a human had to correct.
  wasteStreamOverridden Boolean      @default(false)

  assignmentType AssignmentType @default(MANUAL)
  detectedWardId String?

  status      ComplaintStatus @default(PENDING)
  severity    Severity        @default(MEDIUM)
  isEmergency Boolean         @default(false)
  channel     ReportChannel   @default(WEB)

  description String?
  latitude    Float
  longitude   Float
  address     String?
  photoUrl    String?
  thumbUrl    String?

  assignedVehicleId  String?
  assignedById       String?
  assignedAt         DateTime?
  resolvedById       String?
  resolvedAt         DateTime?
  resolutionPhotoUrl String?
  resolutionNote     String?

  slaMinutes Int       @default(1440)
  dueAt      DateTime?

  /// Officer deferral. Recorded as fields rather than left to be parsed back
  /// out of a timeline note, because the citizen is shown the reason and the
  /// new date verbatim and neither should depend on string formatting.
  deferredAt      DateTime?
  deferredReason  String?
  /// How many times this report has been pushed back. A report deferred four
  /// times is a different problem from one deferred once, and only the count
  /// makes that visible.
  deferredCount   Int       @default(0)
  escalationCount Int       @default(0)
  upvotes         Int       @default(0)
  duplicateOfId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  citizen          User                 @relation("ComplaintCitizen", fields: [citizenId], references: [id], onDelete: Cascade)
  ward             Ward?                @relation(fields: [wardId], references: [id], onDelete: SetNull)
  detectedWard     Ward?                @relation("ComplaintDetectedWard", fields: [detectedWardId], references: [id], onDelete: SetNull)
  assignedVehicle  Vehicle?             @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  assignedBy       User?                @relation("ComplaintAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  resolvedBy       User?                @relation("ComplaintResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  duplicateOf      Complaint?           @relation("ComplaintDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates       Complaint[]          @relation("ComplaintDuplicates")
  duplicateLinks   ComplaintDuplicate[] @relation("DuplicateParent")
  duplicateOfLinks ComplaintDuplicate[] @relation("DuplicateChild")
  events           ComplaintEvent[]
  escalations      Escalation[]
  creditEntries    GreenCredit[]
  feedbacks        Feedback[]
  citizen            User                  @relation("ComplaintCitizen", fields: [citizenId], references: [id], onDelete: Cascade)
  ward               Ward?                 @relation(fields: [wardId], references: [id], onDelete: SetNull)
  detectedWard       Ward?                 @relation("ComplaintDetectedWard", fields: [detectedWardId], references: [id], onDelete: SetNull)
  assignedVehicle    Vehicle?              @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  assignedBy         User?                 @relation("ComplaintAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  resolvedBy         User?                 @relation("ComplaintResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  duplicateOf        Complaint?            @relation("ComplaintDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates         Complaint[]           @relation("ComplaintDuplicates")
  duplicateLinks     ComplaintDuplicate[]  @relation("DuplicateParent")
  duplicateOfLinks   ComplaintDuplicate[]  @relation("DuplicateChild")
  events             ComplaintEvent[]
  escalations        Escalation[]
  creditEntries      GreenCredit[]
  companyAssignments ComplaintAssignment[]

  @@index([status])
  @@index([assignmentType])
  @@index([detectedWardId])
  @@index([wardId, status])
  @@index([isEmergency, status])
  @@index([createdAt])
  @@index([latitude, longitude])
  /// Drives the officer's category-wise breakdown, which is always ward-scoped.
  @@index([wardId, wasteStream])
  @@map("complaints")
}

/// "5 people also reported this" — CLIP-style similarity + proximity + time.
model ComplaintDuplicate {
  id                   String   @id @default(cuid())
  parentComplaintId    String
  duplicateComplaintId String
  similarityScore      Float
  method               String   @default("geo+category+time")
  distanceMeters       Float?
  createdAt            DateTime @default(now())

  parent    Complaint @relation("DuplicateParent", fields: [parentComplaintId], references: [id], onDelete: Cascade)
  duplicate Complaint @relation("DuplicateChild", fields: [duplicateComplaintId], references: [id], onDelete: Cascade)

  @@unique([parentComplaintId, duplicateComplaintId])
  @@map("complaint_duplicates")
}

/// Status timeline shown to the citizen (Pending -> Verified -> ... -> Resolved).
model ComplaintEvent {
  id          String          @id @default(cuid())
  complaintId String
  status      ComplaintStatus
  note        String?
  actorId     String?
  createdAt   DateTime        @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([complaintId, createdAt])
  @@map("complaint_events")
}

// ---------------------------------------------------------------- fleet ----

model Vehicle {
  id                 String        @id @default(cuid())
  registrationNumber String        @unique
  wardId             String?
  driverId           String?       @unique
  status             VehicleStatus @default(OFFLINE)
  model              String        @default("Tata Ace")
  capacityKg         Int           @default(2000)
  maintenanceFlag    Boolean       @default(false)

  /// Denormalised last ping so the fleet map is a single read.
  lastLat     Float?
  lastLng     Float?
  lastHeading Float?
  lastSpeed   Float?
  lastPingAt  DateTime?

  odometerKm Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ward             Ward?                    @relation(fields: [wardId], references: [id], onDelete: SetNull)
  driver           User?                    @relation("VehicleDriver", fields: [driverId], references: [id], onDelete: SetNull)
  locations        VehicleLocation[]
  routes           Route[]
  complaints       Complaint[]
  sosAlerts        SosAlert[]
  fuelLogs         FuelLog[]
  shifts           DriverShift[]
  scheduledPickups ScheduledPickupRequest[]

  @@index([wardId, status])
  @@map("vehicles")
}

/// Every ping, kept for replay, distance stats and future ETA models (§4.5).
model VehicleLocation {
  id         String   @id @default(cuid())
  vehicleId  String
  latitude   Float
  longitude  Float
  heading    Float?
  speed      Float?
  accuracy   Float?
  recordedAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt])
  @@map("vehicle_locations")
}

model Route {
  id        String      @id @default(cuid())
  vehicleId String
  driverId  String?
  wardId    String?
  date      String // YYYY-MM-DD
  status    RouteStatus @default(DRAFT)
  label     String?

  /// Ordered stop list; each entry mirrors RouteStop shape in routing.service.js.
  orderedStops     Json
  polylineGeometry Json // [[lng,lat], ...] — Leaflet draws this directly

  baselineKm  Float  @default(0)
  distanceKm  Float  @default(0)
  durationMin Int    @default(0)
  actualKm    Float  @default(0)
  savedKm     Float  @default(0)
  fuelSaved   Float  @default(0)
  co2SavedKg  Float  @default(0)
  solver      String @default("safaai-node-2opt")
  solveMs     Int    @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  User?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  ward    Ward?   @relation(fields: [wardId], references: [id], onDelete: SetNull)

  @@unique([vehicleId, date])
  @@index([wardId, date])
  @@map("routes")
}

// -------------------------------------------------- ops, audit, comms ----

model Escalation {
  id             String    @id @default(cuid())
  complaintId    String
  escalatedToId  String?
  level          Int       @default(1)
  reason         String
  escalatedAt    DateTime  @default(now())
  acknowledgedAt DateTime?

  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  escalatedTo User?     @relation("EscalationTarget", fields: [escalatedToId], references: [id], onDelete: SetNull)

  @@index([complaintId])
  @@map("escalations")
}

/// Immutable record of every privileged action (plan §2.4, §6.3).
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  targetTable String
  targetId    String?
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetTable, targetId])
  @@map("audit_logs")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

/// Points for verified genuine reports — drives the citizen leaderboard.
model GreenCredit {
  id           String   @id @default(cuid())
  userId       String
  delta        Int
  balanceAfter Int
  reason       String
  reasonCode   String
  complaintId  String?
  createdAt    DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaint Complaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("green_credits")
}

/// Driver SOS — instant alert to nearest officer + admin with live location.
model SosAlert {
  id               String    @id @default(cuid())
  driverId         String
  vehicleId        String?
  latitude         Float
  longitude        Float
  message          String?
  status           SosStatus @default(OPEN)
  acknowledgedById String?
  acknowledgedAt   DateTime?
  createdAt        DateTime  @default(now())

  driver         User     @relation("SosDriver", fields: [driverId], references: [id], onDelete: Cascade)
  vehicle        Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  acknowledgedBy User?    @relation("SosResponder", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("sos_alerts")
}

/// Driver Fuel & Odometer logs for fleet operational analytics.
model FuelLog {
  id         String   @id @default(cuid())
  driverId   String
  vehicleId  String
  liters     Float?
  odometerKm Float?
  cost       Float?
  notes      String?
  receiptUrl String?
  loggedAt   DateTime @default(now())

  driver  User    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([driverId, loggedAt])
  @@index([vehicleId, loggedAt])
  @@map("fuel_logs")
}

/// Explicit driver shift clock.
///
/// The end-of-shift summary used to infer "on shift since" from the first GPS
/// ping of the day, which is not the same fact: a handset that lost signal at
/// the depot, or a driver who opened the app on the bus in, both produce a
/// start time nobody actually worked from. Supervisors also cannot see who is
/// currently clocked on at all from ping data -- a truck silent for ten
/// minutes is indistinguishable from one whose shift ended an hour ago.
model DriverShift {
  id        String  @id @default(cuid())
  driverId  String
  vehicleId String?
  wardId    String?

  /// YYYY-MM-DD, same key shape as Route.date so a shift and its route join.
  date String

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  startLat Float?
  startLng Float?
  endLat   Float?
  endLng   Float?

  startOdometerKm Float?
  endOdometerKm   Float?

  /// Filled on clock-out from the day's GPS track, not from the odometer
  /// fields above -- those are driver-entered and frequently left blank.
  distanceKm Float?
  stopsDone  Int    @default(0)

  /// Total minutes stood down across every break, filled on clock-out.
  breakMinutes Int @default(0)

  notes  String?
  status ShiftStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver  User         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  ward    Ward?        @relation(fields: [wardId], references: [id], onDelete: SetNull)
  breaks  ShiftBreak[]

  @@index([driverId, date])
  @@index([date, status])
  @@index([status, startedAt])
  @@map("driver_shifts")
}

/// One rest period inside a shift.
///
/// Stored as rows rather than a running counter on the shift so the officer
/// can see when and how long, not merely a total — "40 minutes of break" reads
/// very differently from "four ten-minute stops" when a route is running late.
/// An open break is one with endedAt still null; there is at most one per
/// shift, which the service enforces.
model ShiftBreak {
  id        String    @id @default(cuid())
  shiftId   String
  reason    String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  /// Where the driver stood down, for the officer's map.
  latitude  Float?
  longitude Float?

  shift DriverShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId, startedAt])
  @@map("shift_breaks")
}

/// "Tomorrow this zone likely overflows" (plan §2.3, §7).
model HotspotPrediction {
  id             String   @id @default(cuid())
  wardId         String
  forDate        String // YYYY-MM-DD
  predictedCount Float
  riskScore      Int
  confidence     Float    @default(0)
  drivers        Json? // top contributing features, shown in the UI
  modelVersion   String   @default("hotspot-v1")
  createdAt      DateTime @default(now())

  ward Ward @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([wardId, forDate])
  @@map("hotspot_predictions")
}

/// Community directory — cached offline on the citizen app.
model EmergencyContact {
  id         String   @id @default(cuid())
  name       String
  category   String // helpline | fire | animal_control | pest_control | police | hospital
  phone      String
  wardId     String?
  isCityWide Boolean  @default(true)
  address    String?
  createdAt  DateTime @default(now())

  ward Ward? @relation(fields: [wardId], references: [id], onDelete: SetNull)

  @@index([category])
  @@map("emergency_contacts")
}

// ------------------------------------------- processing companies & handoff ----

/// A downstream processor — the firm that actually takes the waste away.
///
/// Distinct from a Vehicle: a truck is the corporation's own collection asset
/// and answers to a driver on a route, whereas a company is an external party
/// that is licensed for particular streams and has finite daily intake. A
/// complaint can need both — a truck to lift it and a company to receive it.
model Company {
  id   String @id @default(cuid())
  name String
  /// Short human key used on the admin table and in exports, e.g. "GRN-BIO-01".
  code String @unique

  contactName  String?
  contactPhone String
  contactEmail String?
  address      String?

  /// Which streams this company is licensed to take. An enum array rather than
  /// a join table: the set is small, fixed, and always read whole — the only
  /// query is "does this company accept X", which `has` answers on an index.
  acceptedStreams WasteStream[]

  /// Daily intake ceiling. Used to rank suggestions, not to hard-block an
  /// officer: a ward with one licensed hazardous handler must still be able to
  /// assign to it when it is near capacity, with the pressure made visible.
  capacityKgPerDay Int @default(0)

  /// Depot location, for the proximity leg of the suggestion ranking.
  latitude  Float?
  longitude Float?

  /// True when the company serves the whole city rather than named wards.
  /// Kept explicit so "covers everywhere" is a stated fact rather than the
  /// accidental meaning of an empty coverage list.
  isCityWide Boolean       @default(false)
  status     CompanyStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wards       CompanyWard[]
  assignments ComplaintAssignment[]

  @@index([status])
  @@map("companies")
}

/// Ward coverage for a company, mirroring the WardOfficer join.
model CompanyWard {
  id        String   @id @default(cuid())
  companyId String
  wardId    String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ward    Ward    @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([companyId, wardId])
  @@index([wardId])
  @@map("company_wards")
}

/// One complaint handed to one company by one officer.
///
/// A row rather than a set of columns on Complaint, because a handoff can be
/// cancelled and re-made — a company refuses the load, or the stream turns out
/// to be wrong on arrival — and the admin view is accountability reporting:
/// who sent what where, including the attempt that was withdrawn. Columns
/// would overwrite that history on the second assignment.
model ComplaintAssignment {
  id           String  @id @default(cuid())
  complaintId  String
  companyId    String
  /// The ward officer who made the call. Never null in practice, but SetNull
  /// on delete so removing a staff account cannot erase the handoff record.
  assignedById String?

  status AssignmentStatus @default(PENDING_PICKUP)

  /// The stream this was assigned under, copied at assignment time.
  ///
  /// Denormalised on purpose: the complaint's own stream can later be
  /// corrected, and the report has to keep showing what the officer actually
  /// decided on, not what the record was retconned to afterwards.
  wasteStream WasteStream

  /// Officer's estimate at handoff, in the same bands the citizen already uses
  /// on scheduled pickups.
  estimatedQuantity WasteQuantity @default(MEDIUM)
  /// Weighed on completion. Volume analytics prefer this and fall back to the
  /// nominal weight of the band above, so a chart is never silently empty.
  actualQuantityKg  Float?

  note String?

  pickedAt     DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  complaint  Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignedBy User?     @relation("CompanyAssignmentOfficer", fields: [assignedById], references: [id], onDelete: SetNull)

  /// A complaint may only have one live handoff at a time. Enforced in the
  /// service rather than here, because a partial unique index over
  /// "status not in (CANCELLED)" is not expressible in Prisma schema.
  @@index([complaintId, status])
  @@index([companyId, status])
  @@index([assignedById, createdAt])
  @@index([createdAt])
  @@map("complaint_assignments")
}

/// Model health panel (plan §2.4) — one row per inference batch summary.
model ModelHealthSample {
  id                String   @id @default(cuid())
  modelVersion      String
  avgConfidence     Float
  lowConfidenceRate Float
  falsePositiveRate Float    @default(0)
  sampleCount       Int
  recordedAt        DateTime @default(now())

  @@index([modelVersion, recordedAt])
  @@map("model_health_samples")
}

// ------------------------------------------------ Scheduled Pickup Requests ----

enum ScheduledPickupStatus {
  PENDING_REVIEW
  APPROVED_SCHEDULED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum WasteQuantity {
  SMALL
  MEDIUM
  LARGE
}

enum TimeSlot {
  MORNING
  AFTERNOON
  EVENING
}

enum LocationType {
  MY_HOME
  COMMON_PLOT_SOCIETY
}

model ScheduledPickupRequest {
  id                 String                @id @default(cuid())
  code               String                @unique // e.g. SP-A8F2K1
  citizenId          String
  wardId             String?
  locationType       LocationType          @default(MY_HOME)
  address            String
  latitude           Float
  longitude          Float
  eventReason        String
  expectedCategories Json
  expectedQuantity   WasteQuantity         @default(MEDIUM)
  scheduledDate      DateTime
  scheduledTimeSlot  TimeSlot              @default(MORNING)
  additionalNotes    String?
  status             ScheduledPickupStatus @default(PENDING_REVIEW)
  rejectionReason    String?

  assignedDriverId  String?
  assignedVehicleId String?
  assignedById      String?
  assignedAt        DateTime?

  completedAt        DateTime?
  completionPhotoUrl String?
  completionNotes    String?

  reminderSent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  citizen         User     @relation("CitizenScheduledPickups", fields: [citizenId], references: [id], onDelete: Cascade)
  ward            Ward?    @relation(fields: [wardId], references: [id], onDelete: SetNull)
  assignedDriver  User?    @relation("DriverScheduledPickups", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  assignedVehicle Vehicle? @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)

  @@index([citizenId, status])
  @@index([wardId, scheduledDate])
  @@index([assignedDriverId, scheduledDate])
  @@map("scheduled_pickup_requests")
}

enum FeedbackCategory {
  SERVICE_QUALITY
  RESPONSE_TIME
  STAFF_BEHAVIOR
  APP_EXPERIENCE
  OTHER
}

enum FeedbackStatus {
  NEW
  REVIEWED
  RESOLVED
}

model Feedback {
  id          String           @id @default(cuid())
  citizenId   String
  complaintId String?
  rating      Int              // 1 to 5 stars
  category    FeedbackCategory @default(SERVICE_QUALITY)
  comment     String?
  sentiment   String?          // POSITIVE, NEUTRAL, NEGATIVE
  status      FeedbackStatus   @default(NEW)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  citizen   User       @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  complaint Complaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull)

  @@index([citizenId])
  @@index([complaintId])
  @@index([status])
  @@index([createdAt])
  @@map("feedbacks")
}


